# =============================================================================
# PyQuest environment variables: TEMPLATE ONLY
#
# Copy this file to a new file named .env in the project root and replace the
# placeholder values. .env is git-ignored and must never be committed; this
# example file is committed so anyone setting up the project knows which
# variables exist.
#
# In production these are set in the hosting platform's dashboard instead of
# a .env file.
# =============================================================================

# Which settings class to use: development, testing, or production.
# Defaults to development when unset.
FLASK_CONFIG=development

# Signs session cookies. Must be long, random, and secret in production.
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-value

# Database connection string. Leave unset locally to use the default SQLite
# file in the instance/ folder. In production, set this to the Neon Postgres
# connection string.
# DATABASE_URL=